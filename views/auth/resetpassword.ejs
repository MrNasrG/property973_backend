<div class="text-center mb-4">
    <div class="auth-logo mb-2"><i class="bi bi-grid-fill"></i> Admin</div>
    <p class="text-muted">Set new password</p>
</div>

<% if (messages && messages.error && messages.error.length > 0) { %>
    <div class="alert alert-danger"><%= messages.error[0] %></div>
<% } %>

<form action="/resetpassword" method="POST">
    <input type="hidden" name="resetToken" value="<%= resetToken %>">
    <div class="mb-3">
        <label class="form-label fw-semibold">New Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter new password" required>
    </div>
    <div class="mb-4">
        <label class="form-label fw-semibold">Confirm Password</label>
        <input type="password" name="confirm_password" class="form-control" placeholder="Confirm new password" required>
    </div>
    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Reset Password</button>
</form>
