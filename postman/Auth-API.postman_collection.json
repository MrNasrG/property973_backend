                  "    if (j.data.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);",
                  "    if (j.data.refreshToken) pm.collectionVariables.set('refreshToken', j.data.refreshToken);",
                  "  }",
                  "} catch (_e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{sampleMobile}}\",\n  \"otp\": \"{{lastOtp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/otp/verify",
            "description": "Same **`POST `/auth/otp/verify`**` as signup folder — reuse after OTP Send."
          },
          "response": []
        }
      ]
    },
