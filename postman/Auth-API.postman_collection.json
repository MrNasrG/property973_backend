    {
      "name": "Password reset (email link)",
      "description": "Send `{ \"email\" }` to **POST `/auth/forgot-password`**. User receives a branded email with a **Reset password** button linking to **`APP_PUBLIC_URL/resetpassword?token=`**. Enable **`PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=1`** to capture **`resetToken`** without reading email.",
      "item": [
        {
          "name": "POST Forgot password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "try {",
                  "  const j = pm.response.json();",
                  "  pm.test('success true', () => pm.expect(j).to.have.property('success', true));",
                  "  if (j.data?.resetToken) {",
                  "    pm.collectionVariables.set('resetToken', String(j.data.resetToken));",
                  "    pm.test('resetToken captured', () => pm.expect(pm.collectionVariables.get('resetToken')).to.be.ok);",
                  "  } else if (pm.response.code === 200) {",
                  "    console.warn('Forgot password: no data.resetToken (set PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=1 or use email link).');",
                  "  }",
                  "} catch (e) { pm.test('Valid JSON', () => { throw e; }); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{sampleAdminEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "**POST `/auth/forgot-password`**\nBody: `{ \"email\": \"user@example.com\" }`. Sends branded password-reset email with **Reset password** CTA. Generic success even if email unknown. May include **`data.resetToken`** when server env allows it."
          },
          "response": []
        },
        {
          "name": "GET Verify reset token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const t = pm.collectionVariables.get('resetToken');",
                  "if (!t) console.warn('resetToken empty — run Forgot password first or paste token from email.');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "try {",
                  "  const j = pm.response.json();",
                  "  pm.test('success true', () => pm.expect(j).to.have.property('success', true));",
                  "} catch (e) { pm.test('Valid JSON', () => { throw e; }); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password/verify?resetToken={{resetToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password", "verify"],
              "query": [{ "key": "resetToken", "value": "{{resetToken}}" }]
            },
            "description": "**GET `/auth/reset-password/verify?resetToken=`** — check token before showing reset form in mobile/web app."
          },
          "response": []
        },
        {
          "name": "POST Reset password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const t = pm.collectionVariables.get('resetToken');",
                  "if (!t) console.warn('resetToken empty — run Forgot password first.');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "try {",
                  "  const j = pm.response.json();",
                  "  pm.test('success true', () => pm.expect(j).to.have.property('success', true));",
                  "} catch (e) { pm.test('Valid JSON', () => { throw e; }); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"password\": \"NewPass8+\",\n  \"confirmPassword\": \"NewPass8+\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/reset-password",
            "description": "**POST `/auth/reset-password`**\nBody: `resetToken`, `password`, `confirmPassword` (optional but recommended)."
          },
          "response": []
        }
      ]
    },
