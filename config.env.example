# Database (Hostinger MySQL from hPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456_yourdb
DB_USER=u123456_youruser
DB_PASSWORD=your_db_password

# App
NODE_ENV=development
PORT=3000
APP_NAME=Property 973
APP_PUBLIC_URL=https://yourdomain.com
# Optional: override logo URL in emails (defaults to APP_PUBLIC_URL/property973-logo.png)
# BRAND_LOGO_URL=https://yourdomain.com/property973-logo.png
# OTP "Copy code" button (defaults to APP_PUBLIC_URL if API shares the same host)
# APP_API_PUBLIC_URL=https://api.yourdomain.com
SESSION_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

 ─── Email (SMTP — Hostinger / Titan) ─────────
# Titan (most Hostinger plans): https://app.titan.email/mail/
#   Settings → Enable Titan on other apps (required for SMTP)
#   SMTP: smtp.titan.email · port 465 + EMAIL_SECURE=1
# Hostinger Email (non-Titan): smtp.hostinger.com · port 587 + EMAIL_SECURE=0
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_SECURE=0
EMAIL_USERNAME=info@admin.property973.com
EMAIL_PASSWORD=Info@property973
EMAIL_FROM=info@admin.property973.com

# Email subjects
EMAIL_FORGET_PSWD_SUBJECT=Reset your password
EMAIL_OTP_SUBJECT=Your verification code
EMAIL_WELCOME_SUBJECT=Welcome

# Dev helpers (set OTP_HIDE_FROM_RESPONSE=1 in production)
EMAIL_LOG_LINK=1
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=1

# ─── SMS (Twilio Verify — recommended) ───────
# TWILIO_ACCOUNT_SID=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_API_KEY=
# TWILIO_CLIENT_SECRET=
# Optional: Messaging API fallback (custom OTP text) if Verify is not used
# TWILIO_PHONE_NUMBER=
# Log Twilio OTP API request/response bodies (enabled in non-production by default)
# TWILIO_LOG_RESPONSE=1

# ─── App branding & URLs ──────────────────────
APP_NAME=Property 973
APP_PUBLIC_URL=https://property973.com
# OTP copy link host (defaults to APP_PUBLIC_URL; set if API is on another origin)
# APP_API_PUBLIC_URL=https://property973.com

# ─── Listing photos ───────────────────────────
# LISTING_PHOTO_MAX_BYTES=5242880
# LISTING_PHOTO_UPLOAD_DIR=
# LISTING_PHOTO_PUBLIC_BASE_URL=
